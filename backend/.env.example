# ===========================================================================
# Safar Sathi - Backend Environment Configuration Template
# ===========================================================================
# Quick Start:
#   1. Copy this file: `cp .env.example .env`
#   2. Default settings work out of the box with SQLite for local development.
#   3. For production, update ENVIRONMENT, AUTH_SECRET, and DATABASE_URL.
# ===========================================================================


# "development" locally; set to "production" (or similar) in a real deployment.
# Also gates AUTH_SECRET enforcement (see below) - anything other than
# "development" REQUIRES a real AUTH_SECRET or the app refuses to start.
ENVIRONMENT=development

# SQLite by default (file location relative to backend/) - zero setup for
# local dev. PostgreSQL is fully supported too, and is what production uses
# (Neon - see DEPLOYMENT.md). Both `postgres://` and `postgresql://`
# schemes are accepted and normalized to the psycopg3 driver automatically -
# paste whatever your host (or Neon) hands you unmodified.
#
# To run against local Docker Postgres instead of SQLite:
#   copy docker.env.example .env.docker   (repo root, then edit the password)
#   docker compose --env-file .env.docker up -d
# then set (matching whatever POSTGRES_* values are in .env.docker):
#   DATABASE_URL=postgresql://safarsathi:<your .env.docker password>@localhost:5433/safarsathi
DATABASE_URL=sqlite:///./safarsathi.db

# Connection pool tuning - only applies when DATABASE_URL is Postgres (SQLite
# ignores these; see app/database/session.py). Defaults are conservative on
# purpose: Neon's free tier has a real cap on concurrent connections, and
# this is a single backend instance, not a fleet.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Recycle pooled connections after this many seconds, so a connection Neon's
# pooler silently dropped for being idle doesn't surface as a query failure -
# pool_pre_ping (always on for Postgres, not configurable) catches the rest.
DB_POOL_RECYCLE_SECONDS=300

# Comma-separated list of origins allowed to call this API (the Vite dev server
# locally; your deployed frontend's real origin in production). Never set this to
# "*" - CORS is configured with allow_credentials=True, and browsers reject a
# wildcard origin combined with credentialed requests anyway.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables the real LLM-backed AI assistant via Anthropic's API.
# If unset, the assistant falls back to a deterministic, engine-grounded responder
# and the application remains fully functional.
ANTHROPIC_API_KEY=

# Model used for the assistant when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-4-5

# HMAC secret used to sign session tokens (see app/services/auth_service.py).
# REQUIRED: set this to a real random value before deploying anywhere other than
# your own machine. Leaving the default means anyone can forge a valid session
# token for any traveler id. If ENVIRONMENT is not "development", the app
# refuses to start at all while this is left at the default - it's not just a
# warning anymore.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=dev-secret-change-me

# How many days a session token stays valid after login before the holder
# must log in again. Enforced server-side; there's no silent refresh.
AUTH_TOKEN_TTL_DAYS=30

# Rate limits for the login/register endpoints, in the format the `limits`
# package expects (e.g. "10/minute", "5/hour"). Keep these generous enough
# that a real user retrying a typo'd password won't get blocked, but low
# enough to stop obvious brute-force/registration-spam automation.
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

# Open-Meteo risk scoring: per-provider request timeout and whole risk-request budget.
WEATHER_REQUEST_TIMEOUT_SECONDS=3
WEATHER_TOTAL_TIMEOUT_SECONDS=4

# Blend live Open-Meteo weather into the weather risk score, capped at ±20 points
# from the deterministic time-of-day heuristic. Set false to use the heuristic only
# (no weather network calls from risk scoring).
WEATHER_RISK_ENABLED=true

# Live traveler signals: real public posts from Mastodon hashtag timelines
# (zero-auth, no key). Falls back to labelled simulated signals when none are
# available. Set false for simulated signals only (no network calls).
SOCIAL_SIGNALS_LIVE_ENABLED=true


# ---------------------------------------------------------------------------
# Production readiness settings (all default to safe/off)
# ---------------------------------------------------------------------------

# Seed the three demo trips + demo traveler on startup. Keep false in production.
# Leave unset to seed only when ENVIRONMENT=development; set false for real deployments.
# SEED_DEMO_DATA=false

# Reject requests without a bearer token (instead of using the demo traveler).
# Set true for any real deployment.
REQUIRE_AUTHENTICATION=false

# Per-IP rate limits (SlowAPI syntax) for costly endpoints.
DISRUPTION_RATE_LIMIT=30/minute
RECOVERY_RATE_LIMIT=30/minute
ASSISTANT_RATE_LIMIT=20/minute

# Background re-scoring of weather + connection risk for upcoming trips.
RISK_PREDICTION_ENABLED=false
RISK_PREDICTION_INTERVAL_MINUTES=15

# Transactional email. When disabled, emails are only logged.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Safar Sathi <no-reply@safarsathi.app>

# Observability. LOG_FORMAT=json for log aggregators; SENTRY_DSN enables Sentry.
LOG_FORMAT=console
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Provider integrations: mock (simulated inventory) or live (real APIs where
# configured, falling back to simulated per request). Flights use Amadeus.
PROVIDER_MODE=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
PROVIDER_TIMEOUT_SECONDS=6

# ---------------------------------------------------------------------------
# Nugen Intelligence (domain-aligned travel reasoning model)
# ---------------------------------------------------------------------------
# Leave NUGEN_API_KEY empty to use the built-in heuristic reasoning engine.
# Build/upload the alignment dataset: python scripts/export_nugen_dataset.py [--upload]
NUGEN_API_KEY=
NUGEN_MODEL_ID=safar-sathi-travel-twin-v1
NUGEN_BASE_URL=https://api.nugen.in
NUGEN_TIMEOUT_SECONDS=12
# ---------------------------------------------------------------------------
# Live travel data (server-side only - never use VITE_* names for these)
# ---------------------------------------------------------------------------
# Leave a key empty to disable that provider: its endpoints answer "not
# configured" instead of falling back to simulated data.
AVIATIONSTACK_API_KEY=
RAILRADAR_API_KEY=
TICKETMASTER_API_KEY=
# Optional overrides
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
RAILRADAR_BASE_URL=https://api.railradar.in
TICKETMASTER_BASE_URL=https://app.ticketmaster.com
# Hotels/places: nominatim (default, free, keyless) or overpass
PLACES_PROVIDER=nominatim
OVERPASS_URL=https://overpass-api.de/api/interpreter
LIVE_PROVIDER_TIMEOUT_SECONDS=8
