# Backend configuration for TripRescue.
# Copy this file to .env and fill in real values. Never commit .env.

# "development" locally; set to "production" (or similar) in a real deployment.
# Surfaced read-only on GET /api/health - not used to change any security behavior
# by itself, but a mismatch here is a quick way to notice a misconfigured deploy.
ENVIRONMENT=development

# SQLite file location (relative to backend/ when run locally).
DATABASE_URL=sqlite:///./triprescue.db

# Comma-separated list of origins allowed to call this API (the Vite dev server
# locally; your deployed frontend's real origin in production). Never set this to
# "*" - CORS is configured with allow_credentials=True, and browsers reject a
# wildcard origin combined with credentialed requests anyway.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables the real LLM-backed AI assistant via Anthropic's API.
# If unset, the assistant falls back to a deterministic, engine-grounded responder
# and the application remains fully functional.
ANTHROPIC_API_KEY=

# Model used for the assistant when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-4-5

# HMAC secret used to sign session tokens (see app/services/auth_service.py).
# REQUIRED: set this to a real random value before deploying anywhere other than
# your own machine. Leaving the default means anyone can forge a valid session
# token for any traveler id. The app logs a warning at startup if this is unchanged.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=dev-secret-change-me
