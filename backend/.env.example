# Backend configuration for TripRescue.
# Copy this file to .env and fill in real values. Never commit .env.

# "development" locally; set to "production" (or similar) in a real deployment.
# Also gates AUTH_SECRET enforcement (see below) - anything other than
# "development" REQUIRES a real AUTH_SECRET or the app refuses to start.
ENVIRONMENT=development

# SQLite by default (file location relative to backend/) - zero setup for
# local dev. PostgreSQL is fully supported too, and is what production uses
# (Supabase - see docs/DEPLOYMENT.md). Both `postgres://` and `postgresql://`
# schemes are accepted and normalized to the psycopg3 driver automatically -
# paste whatever your host (or Supabase) hands you unmodified.
#
# To run against local Docker Postgres instead of SQLite:
#   copy docker.env.example .env.docker   (repo root, then edit the password)
#   docker compose --env-file .env.docker up -d
# then set (matching whatever POSTGRES_* values are in .env.docker):
#   DATABASE_URL=postgresql://triprescue:<your .env.docker password>@localhost:5433/triprescue
DATABASE_URL=sqlite:///./triprescue.db

# Connection pool tuning - only applies when DATABASE_URL is Postgres (SQLite
# ignores these; see app/database/session.py). Defaults are conservative on
# purpose: Supabase's free tier has a real cap on concurrent connections, and
# this is a single backend instance, not a fleet.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Recycle pooled connections after this many seconds, so a connection Supabase's
# pooler silently dropped for being idle doesn't surface as a query failure -
# pool_pre_ping (always on for Postgres, not configurable) catches the rest.
DB_POOL_RECYCLE_SECONDS=300

# Comma-separated list of origins allowed to call this API (the Vite dev server
# locally; your deployed frontend's real origin in production). Never set this to
# "*" - CORS is configured with allow_credentials=True, and browsers reject a
# wildcard origin combined with credentialed requests anyway.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables the real LLM-backed AI assistant via Anthropic's API.
# If unset, the assistant falls back to a deterministic, engine-grounded responder
# and the application remains fully functional.
ANTHROPIC_API_KEY=

# Model used for the assistant when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-4-5

# HMAC secret used to sign session tokens (see app/services/auth_service.py).
# REQUIRED: set this to a real random value before deploying anywhere other than
# your own machine. Leaving the default means anyone can forge a valid session
# token for any traveler id. If ENVIRONMENT is not "development", the app
# refuses to start at all while this is left at the default - it's not just a
# warning anymore.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=dev-secret-change-me

# How many days a session token stays valid after login before the holder
# must log in again. Enforced server-side; there's no silent refresh.
AUTH_TOKEN_TTL_DAYS=30

# Rate limits for the login/register endpoints, in the format the `limits`
# package expects (e.g. "10/minute", "5/hour"). Keep these generous enough
# that a real user retrying a typo'd password won't get blocked, but low
# enough to stop obvious brute-force/registration-spam automation.
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
