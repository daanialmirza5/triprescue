              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Traveler",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.chen@example.com\",\n  \"password\": \"traveler123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "List Trips",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips"]
            }
          }
        },
        {
          "name": "Get Trip by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Disruptions & Recovery",
      "item": [
        {
          "name": "Simulate Disruption",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trip_id\": \"{{tripId}}\",\n  \"node_id\": \"flight-node-01\",\n  \"disruption_type\": \"cancellation\",\n  \"severity\": \"critical\",\n  \"description\": \"Flight cancelled due to typhoon alert\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/disruptions/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "disruptions", "simulate"]
            }
          }
        },
        {
          "name": "Apply Recovery Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_id\": \"rec-option-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/recovery/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recovery", "apply"]
            }
          }
        }
      ]
    }
