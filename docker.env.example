# Local Docker PostgreSQL configuration for SafarSathi development.
# Copy this file to .env.docker and fill in a real local password:
#   copy docker.env.example .env.docker
# (named docker.env.example, not .env.docker.example, because a `.env.*`
# glob in this machine's global gitignore would otherwise silently exclude
# it from git even when explicitly added.)
# .env.docker is gitignored - never commit it. These values only ever reach
# a container bound to localhost on your own machine; they are not used
# anywhere in production (production uses Neon, configured entirely via
# Render's own DATABASE_URL environment variable - see README.md).

POSTGRES_DB=safarsathi
POSTGRES_USER=safarsathi
# Any local value works - this only protects a container on your own
# machine's loopback-bound port, not a real deployment.
POSTGRES_PASSWORD=changeme_local_dev_only

# Host port Docker maps container port 5432 to. Defaults to 5433 (not 5432)
# so it doesn't collide with a Postgres instance you might already have
# running locally for another project. Change it if 5433 is also taken.
POSTGRES_PORT=5433

# Only needed if you repurpose docker-compose.yml for something other than
# local dev. Uncomment and set both together - ENVIRONMENT=production makes
# the backend refuse to boot unless AUTH_SECRET is also a real random value
# (see backend/app/config.py). Leaving both unset keeps today's local-dev
# defaults (ENVIRONMENT=development, AUTH_SECRET=dev-secret-change-me).
# ENVIRONMENT=production
# AUTH_SECRET=
