# Safar Sathi frontend configuration (Vite). Copy to .env.local for local dev.
# Never put backend secrets here - anything prefixed VITE_ is bundled into the
# client-side JS and publicly visible.

# Origin of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Only needed when the built app is served from a sub-path (e.g. GitHub Pages
# at https://<user>.github.io/<repo>/). Read at build time by vite.config.ts.
# VITE_BASE_PATH=/SafarSathi/
