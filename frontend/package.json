{
  "name": "safarsathi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pipeline": "vite --config vite.pipeline.config.ts",
    "build": "vite build",
    "build:pipeline": "vite build --config vite.pipeline.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:pipeline": "vite preview --config vite.pipeline.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "ci": "npm run typecheck && npm run lint"
  },

  "dependencies": {
